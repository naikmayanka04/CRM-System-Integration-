# Copy to .env (git-ignored). Never commit real values.
PORT=3001

# Supabase: Project Settings > Database > Connection string (use the pooler "Session" string for a long-running server).
# Do NOT put ?sslmode=... in the URL; control TLS with DB_SSL below.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DB_SSL=require
# Optional but recommended: path to the Supabase root CA (downloaded from the dashboard) to verify the server certificate.
# Without it, traffic is encrypted but the server identity is not verified.
# DB_SSL_CA=./supabase-ca.crt

# Used ONLY by `npm test` / `npm run test:e2e`. Use a throwaway database or a local Postgres, never production.
# Each run creates and drops its own schema inside it.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_test
# TEST_DB_SSL=off
